# Backend (Render) environment — copy to backend/.env for local dev

# Auth: verifies the Supabase session the frontend sends
SUPABASE_URL=https://peefsudacgowngwvnouk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=
# Emails allowed to use keys / bot / LLM / admin endpoints (comma-separated). Empty = all admin endpoints disabled.
ADMIN_EMAILS=you@example.com
# CORS — your frontend origins
ALLOWED_ORIGINS=https://bot-saros.vercel.app,http://localhost:3000
# Shared secret for cron jobs: send as header  X-Cron-Secret: <value>
CRON_SECRET=

# Exchange keys vault — Fernet key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the existing vault.json unreadable (re-enter keys).
VAULT_MASTER_KEY=
# Global kill switch for real orders. Anything but "true" = paper only.
ALLOW_LIVE_TRADING=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CODECRAFT_API_KEY=
MAX_CONCURRENT_BACKTESTS=2
