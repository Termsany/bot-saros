[Unit]
Description=Raqm bot — daily trend with real orders on Binance Futures Demo Trading (play money), $100 x2, top 10 coins
After=network-online.target
Wants=network-online.target
# not started until the demo keys exist
ConditionPathExists=/opt/raqm-live/.env.live

[Service]
# its own user and read-only code copy, apart from the paper bots (deploy/vps/setup-live.sh)
User=raqmlive
Group=raqmlive
WorkingDirectory=/opt/raqm-live
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
EnvironmentFile=-/opt/raqm-live/.env.telegram
# BINANCE_API_KEY / BINANCE_SECRET made in Binance Demo Trading (API Management in demo mode) — never committed, chmod 600, owner raqmlive
EnvironmentFile=/opt/raqm-live/.env.live
# play money: --expect-env demo makes the bot refuse to start if anything sets BINANCE_ENV to something else.
# (the old futures testnet is gone: ccxt raises NotSupported for it)
Environment=BINANCE_ENV=demo
# the admin page reads live_status.json here and drops manual close requests (deploy/vps/setup-ipc.sh)
Environment=RAQM_IPC_DIR=/opt/raqm-ipc
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/raqm-live/venv/bin/python bot.py --live --expect-env demo --strategy trend_daily --leverage 2 --amount 100 --universe 10 --poll 60 --notify --state state/state_demo.json
Restart=always
RestartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-live/state /opt/raqm-ipc

[Install]
WantedBy=multi-user.target
