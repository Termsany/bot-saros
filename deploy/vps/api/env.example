# Raqm API on the VPS: /opt/raqm-api/.env (mode 600, owner raqmapi). Never commit the filled file.
# Copy each secret from Render -> bot-saros-backend -> Environment, then: systemctl restart raqm-api

# ── secrets (fill in) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ADMIN_EMAILS=
CRON_SECRET=
# same value as on Render; generate a new one with:
#   /opt/raqm-api/venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: LLM lab
CODECRAFT_API_KEY=

# ── not secret ──
ALLOWED_ORIGINS=https://bot-saros.vercel.app,http://localhost:3000
ALLOW_LIVE_TRADING=false
MAX_CONCURRENT_BACKTESTS=2
