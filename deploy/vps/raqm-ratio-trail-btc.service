[Unit]
Description=Raqm bot — ratio trend among the top 7 (BTC/ETH in), out on a 20% trail (paper experiment, research §35)
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
WorkingDirectory=/opt/raqm-ratio-trail-btc
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
# owner, 2026-11-10: next to raqm-ratio, the same bot ($100 x2 a leg, BTC/ETH in) with one change: a pair leaves when
# its ratio is 20% below its best daily value since entry, and stays flat until its 50-day sign turns
# (--ratio-trail 0.20, research §35 B2; with BTC/ETH the gain wasn't steady at 25-30%). Own state
# (state_ratio_trail_btc.json / .log), page data -> ratio_trail_btc.json, Telegram messages marked
# [ratio trail 20% BTC/ETH]. Paper only: no order reaches an exchange. Its own code folder
# (deploy/vps/install-ratio-trail-btc.sh), so installing it never changes the other paper bots' code.
ExecStart=/opt/raqm-bot/venv/bin/python -E -s bot.py --paper --strategy ratio_trend --ratio-trail 0.20 --public-name ratio_trail_btc --label "ratio trail 20% BTC/ETH" --amount 100 --leverage 2 --poll 60 --notify --public /var/www/bot.da3m.io --state state_ratio_trail_btc.json
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-ratio-trail-btc /var/www/bot.da3m.io

[Install]
WantedBy=multi-user.target
