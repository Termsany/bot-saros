[Unit]
Description=Raqm bot — Larry Williams volatility breakout, top 10 Binance coins, next-open exit (paper, research/traders_study.py)
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
WorkingDirectory=/opt/raqm-bot
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
# own state file (state_breakout.json / state_breakout.log); page data -> breakout.json
ExecStart=/opt/raqm-bot/venv/bin/python bot.py --paper --strategy vol_breakout --amount 100 --leverage 2 --poll 60 --notify --public /var/www/bot.da3m.io --state state_breakout.json
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-bot /var/www/bot.da3m.io

[Install]
WantedBy=multi-user.target
