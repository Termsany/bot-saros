# 20 minutes after the daily rebalance (the real bots run --mom-daily, 00:00 UTC): the bot's first cycle after midnight
# closes and opens the basket in a few minutes.
[Unit]
Description=Raqm: check the real rebalance every day at 00:20 UTC

[Timer]
OnCalendar=*-*-* 00:20:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
