# 20 minutes after the weekly rebalance (bot.MOM weekday 2 = Wednesday, 00:00 UTC): the bot's first cycle after midnight
# closes and opens the basket in a few minutes.
[Unit]
Description=Raqm: check the real rebalance on Wednesdays at 00:20 UTC

[Timer]
OnCalendar=Wed *-*-* 00:20:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
