[Unit]
Description=Raqm bot — short new Binance listings (paper experiment, research/short_study.py idea 2)
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
WorkingDirectory=/opt/raqm-bot
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
# own state file (state_listing.json / state_listing.log) next to the trend bot; page data -> listing.json
ExecStart=/opt/raqm-bot/venv/bin/python bot.py --paper --strategy listing_short --amount 100 --leverage 2 --poll 60 --notify --public /var/www/bot.da3m.io --state state_listing.json
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-bot /var/www/bot.da3m.io

[Install]
WantedBy=multi-user.target
