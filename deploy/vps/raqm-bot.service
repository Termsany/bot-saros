[Unit]
Description=Raqm bot — daily trend, paper, $100 x5, top 10 coins by volume
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
WorkingDirectory=/opt/raqm-bot
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID — never committed
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/raqm-bot/venv/bin/python bot.py --paper --strategy trend_daily --leverage 5 --amount 100 --universe 10 --poll 300 --notify --public /var/www/bot.da3m.io
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-bot /var/www/bot.da3m.io

[Install]
WantedBy=multi-user.target
