[Unit]
Description=Raqm bot — weekly momentum long/short on Binance (paper experiment, research/pump_momentum_study.py idea 2)
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
WorkingDirectory=/opt/raqm-bot
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
# own state file (state_momentum.json / state_momentum.log); page data -> momentum.json
ExecStart=/opt/raqm-bot/venv/bin/python bot.py --paper --strategy momentum_ls --amount 20 --leverage 2 --poll 60 --notify --public /var/www/bot.da3m.io --state state_momentum.json
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-bot /var/www/bot.da3m.io

[Install]
WantedBy=multi-user.target
