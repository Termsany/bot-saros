[Unit]
Description=Raqm bot — weekly momentum long/short on Binance (paper experiment, research/pump_momentum_study.py idea 2)
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
# owner, 2026-11-09: its own code folder (deploy/vps/install-momentum-paper.sh), so the paper basket follows the
# current code (Wednesday 00:00 UTC open, Tuesday close, like the real momentum bot) without touching the other paper bots in
# /opt/raqm-bot. It shares their venv and Telegram settings only.
WorkingDirectory=/opt/raqm-momentum-paper
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
# admin close requests from the site (deploy/vps/setup-paper-ipc.sh)
Environment=RAQM_PAPER_IPC=/opt/raqm-ipc-paper
# own state file (state_momentum.json / state_momentum.log); page data -> momentum.json
ExecStart=/opt/raqm-bot/venv/bin/python -E -s bot.py --paper --strategy momentum_ls --amount 100 --leverage 2 --poll 60 --notify --public /var/www/bot.da3m.io --state state_momentum.json
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-momentum-paper /var/www/bot.da3m.io /opt/raqm-ipc-paper

[Install]
WantedBy=multi-user.target
