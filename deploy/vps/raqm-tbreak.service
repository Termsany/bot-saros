[Unit]
Description=Raqm bot — trend-template breakout, top 100 Binance coins (paper experiment, research/vcp_deep.py)
After=network-online.target
Wants=network-online.target

[Service]
User=raqm
Group=raqm
WorkingDirectory=/opt/raqm-bot
EnvironmentFile=-/opt/raqm-bot/.env
Environment=PYTHONUNBUFFERED=1
# admin close requests from the site (deploy/vps/setup-paper-ipc.sh)
Environment=RAQM_PAPER_IPC=/opt/raqm-ipc-paper
# own state file (state_tbreak.json / state_tbreak.log); page data -> tbreak.json
ExecStart=/opt/raqm-bot/venv/bin/python bot.py --paper --strategy trend_breakout --amount 100 --leverage 2 --poll 60 --notify --public /var/www/bot.da3m.io --state state_tbreak.json
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/raqm-bot /var/www/bot.da3m.io /opt/raqm-ipc-paper

[Install]
WantedBy=multi-user.target
