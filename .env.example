# Copy these to Vercel Dashboard → Settings → Environment Variables
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
NEXT_PUBLIC_SUPABASE_URL=https://peefsudacgowngwvnouk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# checkouts charge the plan prices set in the admin (المالية); these price ids only map subscriptions made before that
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
# optional: reuse your Stripe products for new checkouts (without them Stripe creates one per checkout)
STRIPE_STARTER_PRODUCT_ID=prod_...
STRIPE_PRO_PRODUCT_ID=prod_...
STRIPE_ELITE_PRODUCT_ID=prod_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_SITE_URL=https://bot-saros.vercel.app
BACKEND_URL=https://your-backend.railway.app
# server-only (Vercel) — Stripe webhook writes tier with this; never NEXT_PUBLIC_
SUPABASE_SERVICE_KEY=
